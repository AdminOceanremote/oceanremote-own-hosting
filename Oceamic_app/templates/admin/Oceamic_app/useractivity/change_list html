{% extends "admin/change_list.html" %}
{% load humanize %}

{% block content_title %}
<h1>🚀 Real-time User Activity Monitor</h1>
{% endblock %}

{% block result_list %}
<div class="activity-monitor">
    <!-- Live Status Cards -->
    <div class="status-cards">
        <div class="card active-users">
            <h3>🟢 Active Now</h3>
            <p>{{ active_users.count }}</p>
        </div>
        <div class="card total-views">
            <h3>👀 Total Views</h3>
            <p>{{ total_views|intcomma }}</p>
        </div>
    </div>

    <!-- Original Admin Table -->
    {{ block.super }}

    <!-- Active Sessions List -->
    <div class="session-list">
        <h3>📱 Live Devices</h3>
        <ul>
            {% for activity in active_users %}
            <li>
                <strong>{{ activity.user.username }}</strong>
                <span class="device-id">{{ activity.device.device_id|default:"No device" }}</span>
                <span class="last-seen">{{ activity.last_activity|timesince }} ago</span>
            </li>
            {% empty %}
            <li>No active sessions</li>
            {% endfor %}
        </ul>
    </div>
</div>

<style>
.status-cards {
    display: flex;
    gap: 15px;
    margin: 20px 0;
}
.card {
    flex: 1;
    padding: 15px;
    border-radius: 5px;
    background: #f8f9fa;
}
.active-users { border-left: 4px solid #4CAF50; }
.total-views { border-left: 4px solid #2196F3; }
.session-list {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #eee;
}
.session-list li {
    padding: 8px 0;
    border-bottom: 1px dashed #eee;
}
.device-id {
    color: #666;
    font-size: 0.9em;
    margin: 0 10px;
}
.last-seen {
    float: right;
    color: #999;
}
</style>
{% endblock %}