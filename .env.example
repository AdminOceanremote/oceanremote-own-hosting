# Copy this file to .env and fill in your values.
# Or just run: python wizard.py

DEBUG=False

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY="CHANGE-ME-INSECURE-DEV-KEY"

# Comma-separated. Example: mysite.pythonanywhere.com,127.0.0.1,localhost
DJANGO_ALLOWED_HOSTS="127.0.0.1,localhost"

# Comma-separated https:// origins. Example: https://mysite.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=""
